                  "kind": "endpoint"
                }
              ]
            }
          ],
          "properties": {
            "checkName": "schema_bypass",
            "severity": "medium",
            "connectionId": "75f013ae-c1c7-4b31-86b8-d33990f5406b",
            "messageId": "poc-message-1",
            "remediation": "Implement strict schema validation for all incoming messages; reject messages with missing required fields.",
            "evidence": [
              {
                "type": "missing_field",
                "label": "removed field",
                "value": "data"
