          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Server accepted message with missing required field: Removing field \"data\" from the message did not cause rejection, suggesting the server does not validate required fields."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ws://127.0.0.1:18090/ws/"
                }
              },
              "logicalLocations": [
                {
