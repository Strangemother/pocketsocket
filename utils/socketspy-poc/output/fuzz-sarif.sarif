{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "socketspy",
          "semanticVersion": "dev",
          "informationUri": "https://github.com/0xsj/socketspy",
          "rules": [
            {
              "id": "socketspy/fuzzer",
              "name": "Fuzzer",
              "shortDescription": {
                "text": "fuzzer security check"
              },
              "properties": {
                "tags": [
                  "security",
                  "websocket"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "socketspy/fuzzer",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Error response to fuzz payload: Mutation 'xss_img@action' at path 'action' triggered an error containing 'error'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ws://127.0.0.1:18090/ws/"
                }
              },
              "logicalLocations": [
                {
                  "name": "ws://127.0.0.1:18090/ws/",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "properties": {
            "checkName": "fuzzer",
            "severity": "medium",
            "connectionId": "580ac933-a059-4bad-ba5c-044393630f7a",
            "remediation": "Ensure proper input validation and error handling for all WebSocket message fields.",
            "evidence": [
              {
                "type": "mutation",
                "label": "mutation name",
                "value": "xss_img@action"
              },
              {
                "type": "indicator",
                "label": "error indicator",
                "value": "error"
              }
            ]
          }
        },
        {
          "ruleId": "socketspy/fuzzer",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Error response to fuzz payload: Mutation 'xss_img@data' at path 'data' triggered an error containing 'error'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ws://127.0.0.1:18090/ws/"
                }
              },
              "logicalLocations": [
                {
                  "name": "ws://127.0.0.1:18090/ws/",
                  "kind": "endpoint"
                }
              ]
            }
          ],
          "properties": {
            "checkName": "fuzzer",
            "severity": "medium",
            "connectionId": "580ac933-a059-4bad-ba5c-044393630f7a",
            "remediation": "Ensure proper input validation and error handling for all WebSocket message fields.",
            "evidence": [
              {
                "type": "mutation",
                "label": "mutation name",
                "value": "xss_img@data"
              },
              {
                "type": "indicator",
                "label": "error indicator",
                "value": "error"
              }
            ]
          }
        }
      ]
    }
  ]
}
